<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Cluster</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
    </nav>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            @* Sign-in and sign-out live in Cluster.Identity; this app only renders links to them. *@
            <AuthorizeView>
                <Authorized>
                    <a class="nav-link" href="@IdentityUrl("/identity/logged-out")">Account</a>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link" href="@IdentityUrl("/identity/login")">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    [Inject]
    private IOptions<IdentityClientOptions> IdentityClient { get; set; } = default!;

    private string IdentityUrl(string path)
        => $"{IdentityClient.Value.BaseUrl.TrimEnd('/')}{path}?returnUrl={Uri.EscapeDataString(IdentityClient.Value.ViewBaseUrl.TrimEnd('/') + "/")}";
}